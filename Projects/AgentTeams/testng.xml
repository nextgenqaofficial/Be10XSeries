<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    testng.xml — Test Suite Configuration
    Run with: mvn test

    This suite runs the manually-written LoginTest as a baseline.
    After the agent team generates new tests, add them here too.
-->
<suite name="NextGenQA Agent Teams Demo Suite" verbose="2">

    <test name="Login Tests — Generated by Agent Team">
        <classes>
            <class name="com.nextgenqa.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Checkbox Tests — Generated by Agent Team">
        <classes>
            <class name="com.nextgenqa.tests.CheckboxTest"/>
        </classes>
    </test>

    <test name="Dropdown Tests — Generated by Agent Team">
        <classes>
            <class name="com.nextgenqa.tests.DropdownTest"/>
        </classes>
    </test>

    <test name="Dynamic Loading Tests — Generated by Agent Team">
        <classes>
            <class name="com.nextgenqa.tests.DynamicLoadingTest"/>
        </classes>
    </test>

</suite>
