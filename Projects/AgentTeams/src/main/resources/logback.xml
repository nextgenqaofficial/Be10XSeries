<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender — colored output for YouTube demo visibility -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} [%highlight(%-5level)] %cyan([%logger{20}]) — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender — full logs saved to agent-teams.log -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/agent-teams.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/agent-teams.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%-5level] [%logger{30}] — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set INFO for demo classes, DEBUG for agent internals if needed -->
    <logger name="com.nextgenqa.agents" level="INFO"/>
    <logger name="com.nextgenqa.demo"   level="INFO"/>
    <logger name="com.nextgenqa.tests"  level="INFO"/>

    <!-- Suppress noisy Selenium/OkHttp internal logs -->
    <logger name="org.openqa.selenium"  level="WARN"/>
    <logger name="okhttp3"              level="WARN"/>
    <logger name="io.github.bonigarcia" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
